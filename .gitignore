# --- Data -------------------------------------------------------------------
# The ENA24 images are far too large for git. Only experiment outputs
# (results CSV/JSON + figures) under data/ are tracked.
data/*
!data/results/
!data/figures/
!data/preliminary/
data/results/cache/
*.zip
ena24.json

# --- Models -----------------------------------------------------------------
# Trained/quantized models are regenerated by run.py. Only the shipped FP32
# baseline (+ its metadata) is tracked so the demo works out of the box.
models/*
!models/mobilenet_v2_fp32_res224.pt
!models/mobilenet_v2_res224_meta.json
!models/classes.txt
models_pi/

# --- Python / tooling -------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
.ipynb_checkpoints/
.gradio/
smoke_test_tmp/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# Colab / Google Drive backup folder (duplicates of data/ and models/, plus large files)
CameraTrapML_outputs/
