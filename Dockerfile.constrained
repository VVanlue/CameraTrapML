# Emulates a small field device on your laptop: run the sweep with CPU and RAM caps.
# Run from the repo root after `python run.py all ...` has produced models/ and data/results/accuracy/:
#   docker build -f Dockerfile.constrained -t cameratrap-edge .
#   docker run --rm --cpus=1 --memory=1g \
#       -v "$(pwd)/models:/app/models" -v "$(pwd)/data/results:/app/data/results" cameratrap-edge
# (Windows cmd: use %cd% instead of $(pwd))
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir numpy pandas scikit-learn matplotlib psutil tqdm pillow
COPY src/ src/
# Accuracy was already measured on the laptop, so skip it and time on 1 thread.
CMD ["python", "src/run_sweep.py", "--arch", "mobilenet_v2", "--tag", "docker_1cpu_1gb", \
     "--threads", "1", "--skip_accuracy", "--batch_sizes", "1", "8", "--repeats", "3"]
