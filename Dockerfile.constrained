# Emulates a small field device on your laptop: run with CPU and RAM caps, e.g.
#   docker build -f Dockerfile.constrained -t cameratrap-edge .
#   docker run --rm --cpus=1 --memory=1g -v %cd%/models:/app/models -v %cd%/results:/app/results cameratrap-edge
# (on Mac/Linux use $(pwd) instead of %cd%)
FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir numpy pandas scikit-learn matplotlib psutil tqdm pillow
COPY src/ src/
# Accuracy was already measured on the laptop, so skip it and time on 1 thread.
CMD ["python", "src/run_sweep.py", "--arch", "mobilenet_v2", "--tag", "docker_1cpu_1gb", \
     "--threads", "1", "--skip_accuracy", "--batch_sizes", "1", "4", "8", "--repeats", "3"]
